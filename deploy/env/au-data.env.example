APP_DIR=/opt/ai-dc-dashboard
PYTHON=/opt/ai-dc-dashboard/.venv/bin/python
PUSH_CHANGES=1
# AU FETCH MODE (fetch_aemo_nemosis.py):
#   (unset/empty)  -> publication-lag-aware INCREMENTAL demand refresh:
#                     only months after the last month already present in
#                     nem_demand_actual.parquet are fetched (never a 2020+
#                     replay). This is the recommended routine setting since
#                     S2-08 (C10).
#   --skip-demand  -> legacy behaviour: registration/grid only (alias:
#                    --no-demand). Existing production env files keep working.
#   --full-demand-backfill -> force a full 2020+ history rebuild (explicit
#                    backfill path; not routine).
AU_FETCH_ARGS=
RAW_CACHE_RETENTION_DAYS=540
REPORT_DIR=/var/lib/ai-dc-dashboard/reports/source-health
GIT_AUTHOR_NAME=ai-dc-vps-bot
GIT_AUTHOR_EMAIL=ai-dc-vps-bot@users.noreply.github.com
